# Copy to .env and adjust. NEVER commit the real .env.
DB_USER=shop
DB_PASSWORD=change-me-in-prod
# Used when running the binary directly (compose builds its own DB_URL).
# Host port 5433 — offset from hexagonal-go's 5432 so both DBs run side by side.
DB_URL=postgres://shop:change-me-in-prod@localhost:5433/shop?sslmode=disable
